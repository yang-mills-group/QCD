  YM.Intag.Ibis.Promises.arity : ∀ n ≤ K, ∀ r ≤ 2 ^ n, ↑r * pennies L Hp z w n H + pib L Hp z ≤ minorV L a z
  YM.Intag.Ibis.Promises.tide : ∀ n ≤ K,
      ↑n * (pib L Hp z * reserved L Hp w z ^ n) + (2 ^ n * (H * pib L Hp z) + H * lapT L Hp z) ≤ minorV L a z / 4
  YM.Intag.Ibis.Promises.prep : 1 ≤ unveil L Hp z
  YM.Intag.Ibis.Promises.watch : 4 * (4 * reserved L Hp w z ^ 2 / ↑(unveil L Hp z)) + H * lapT L Hp z ≤ minorV L a z / 2
constructor:
  YM.Intag.Ibis.Promises.mk {L : Side} {D : ℕ} {Hp : Dial D} {w Uq m K a : ℕ} {e v H z : ℝ}
    (hue : Room L Hp w Uq m K e v z) (fonts : w < Hp.e) (permit : 2 ≤ Uq) (dust : 2 * lapT L Hp z ≤ min (v / 4) e)
