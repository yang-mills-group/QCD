info: YM/Mistral/Tails.lean:18:0: structure YM.Massive.Tarn.Orb {C : YM.Massive.Sequence} (P : YM.Massive.Calibration C) (W : YM.Massive.Tarn.Choir)
  (D : ℕ) (X : YM.Massive.Tarn.Pollens P W) : Prop
number of parameters: 5
fields:
  YM.Massive.Tarn.Orb.born : ∃ R M p s B,
      (∀ᶠ (i : ℕ) in Filter.atTop, 0 < R i) ∧
        Filter.Tendsto R Filter.atTop (nhds 0) ∧
          Filter.Tendsto p Filter.atTop Filter.atTop ∧
            (∀ (k : ℕ), Filter.Tendsto (B k) Filter.atTop (nhds 0)) ∧
              ∀ (v : YM.Massive.UV.Label 8),
                X.parity ((W.focus none 8) v) = (W.focus none 8) v →
                  ∀ (u : YM.Massive.UV.Label D) (q : Bool),
                    u ≠ 0 →
                      YM.Massive.Poised.Plans.moored (↑u) q →
                        ∀ᶠ (i : ℕ) in Filter.atTop,
                          ∀ (z : YM.E4),
                            R i ≤ ‖z‖ →
                              ‖z‖ ≤ 2 * R i →
                                ∃ y,
                                  ∀ (f : YM.Massive.Tarn.Choir.Patrol P) (j : ℕ) (Q : Fin f.size → ℝ),
                                    M ≤ j →
                                      s j ≤ p i →
                                        f.Luminous j Q →
                                          YM.points (Fin.cons z (Fin.cons 0 f.land)) ∈ YM.conf (f.size + 2) →
                                            ‖↑(R i ^ 4) * f.gleam W z ((W.focus none 8) v) ((W.focus none D) u) -
                                                  f.glory W ((W.focus none D) y)‖ ≤
                                              B j i * ∏ u, Q u
constructor:
  YM.Massive.Tarn.Orb.mk {C : YM.Massive.Sequence} {P : YM.Massive.Calibration C} {W : YM.Massive.Tarn.Choir} {D : ℕ}
    {X : YM.Massive.Tarn.Pollens P W}
    (born :
      ∃ R M p s B,
        (∀ᶠ (i : ℕ) in Filter.atTop, 0 < R i) ∧
          Filter.Tendsto R Filter.atTop (nhds 0) ∧
            Filter.Tendsto p Filter.atTop Filter.atTop ∧
              (∀ (k : ℕ), Filter.Tendsto (B k) Filter.atTop (nhds 0)) ∧
                ∀ (v : YM.Massive.UV.Label 8),
                  X.parity ((W.focus none 8) v) = (W.focus none 8) v →
                    ∀ (u : YM.Massive.UV.Label D) (q : Bool),
                      u ≠ 0 →
                        YM.Massive.Poised.Plans.moored (↑u) q →
                          ∀ᶠ (i : ℕ) in Filter.atTop,
                            ∀ (z : YM.E4),
                              R i ≤ ‖z‖ →
                                ‖z‖ ≤ 2 * R i →
                                  ∃ y,
                                    ∀ (f : YM.Massive.Tarn.Choir.Patrol P) (j : ℕ) (Q : Fin f.size → ℝ),
                                      M ≤ j →
                                        s j ≤ p i →
                                          f.Luminous j Q →
                                            YM.points (Fin.cons z (Fin.cons 0 f.land)) ∈ YM.conf (f.size + 2) →
                                              ‖↑(R i ^ 4) * f.gleam W z ((W.focus none 8) v) ((W.focus none D) u) -
                                                    f.glory W ((W.focus none D) y)‖ ≤
                                                B j i * ∏ u, Q u) :
    YM.Massive.Tarn.Orb P W D X
